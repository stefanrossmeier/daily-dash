# Generated .env files use absolute host paths. Keep real values out of Git.
DATABASE_URL=postgres://postgres:changeme@db/windmill?sslmode=disable
WM_IMAGE=ghcr.io/windmill-labs/windmill:1.775.1

# Absolute path to the public daily-dash checkout used as the Docker build context.
DAILY_DASH_SOURCE=/absolute/path/to/daily-dash

# Absolute path to a separate Git checkout used only as the data sink.
DAILY_DASH_DATA_SOURCE=/absolute/path/to/daily-dash-data

# Absolute path to a file containing only the OpenRouter API key.
DAILY_DASH_OPENROUTER_KEY_FILE=/absolute/path/to/openrouter_api_key

# Optional Docker json-file rotation overrides.
# LOG_MAX_SIZE=20m
# LOG_MAX_FILE=10
